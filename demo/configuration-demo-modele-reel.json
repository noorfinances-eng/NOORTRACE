  "policy": {
    "version": "demo-2026-12",
    "approval": {
      "rules": {
        "version": 0,
        "default": {
          "name": "defaut : revue",
          "description": "Tout appel qu'aucune règle ne couvre est soumis aux approbateurs.",
          "level": "revue",
          "decision": null,
          "contest_ms": 0
        },
        "rules": [
          {
            "name": "lecture autorisee",
            "description": "Les deux outils de lecture du serveur de démonstration.",
            "tools": [
              "demo__claims.get",
              "demo__claims.search"
            ],
            "when": null,
            "level": "automatique",
            "decision": "autorise",
            "window": null,
            "contest_ms": null
          },
          {
            "name": "paiement hors CHF",
            "description": null,
            "tools": [
              "demo__payments.create"
            ],
            "when": {
              "none": [
                {
                  "path": "/arguments/currency",
                  "op": "egal",
                  "value": "CHF"
                }
              ]
            },
            "level": "automatique",
            "decision": "refuse",
            "window": null,
            "contest_ms": null
          },
          {
            "name": "paiement <= 5000 CHF",
            "description": null,
            "tools": [
              "demo__payments.create"
            ],
            "when": {
              "all": [
                {
                  "path": "/arguments/amount",
                  "op": "strictement_superieur",
                  "value": "0"
                },
                {
                  "path": "/arguments/amount",
                  "op": "inferieur_ou_egal",
                  "value": "5000"
                }
              ]
            },
            "level": "automatique",
            "decision": "autorise",
            "window": null,
            "contest_ms": null
          },
          {
            "name": "montant > 5000",
            "description": "Un paiement au-delà de 5000 CHF attend deux approbateurs.",
            "tools": [
              "demo__payments.create"
            ],
            "when": {
              "path": "/arguments/amount",
              "op": "strictement_superieur",
              "value": "5000"
            },
            "level": "revue",
            "decision": null,
            "window": null,
            "contest_ms": 0
          }
        ],
        "approver_set": {
          "source": "statique",
          "chain_id": null,
          "registry": null,
          "set": null,
          "members": [
            "0x70997970c51812dc3a010c7d01b50e0d17dc79c8",
            "0x3c44cdddb6a900fa2b585dd299e03d12fa4293bc",
            "0x90f79bf6eb2c4f870365e785982e1f101e93b906"
          ],
          "threshold": {
            "required": 2,
            "size": 3
          }
        },
        "separation": {
          "self_approval": "interdite",
          "identities": [
            {
              "launched_by": "agent-demo",
              "addresses": [
                "0x90f79bf6eb2c4f870365e785982e1f101e93b906"
              ]
            }
          ]
        }
      },
      "mode": "erreur",
      "hold_timeout_ms": 50000,
      "expire_after_ms": 3600000,
      "timeout_ms": 2000,
      "service": {
