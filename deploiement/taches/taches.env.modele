# Réglages des tâches planifiées de NOORTRACE (CT-8 EX-8.6, IC-16), lus par
# les unités systemd (EnvironmentFile=/etc/noortrace/taches.env). poser-taches.sh
# copie ce modèle à /etc/noortrace/taches.env s'il n'existe pas (jamais remplacé),
# en mode 0600 : il ne contient aucun secret, seulement des chemins de fichiers.
# Une valeur vide laisse la tâche qui l'exige en échec (code 2 ou 3), ce que
# sa ligne au journal des tâches dit.

# Répertoire d'extraction de l'archive de déploiement (celui qui contient deploiement/ et scripts/).
NOORTRACE_RACINE=@RACINE@
# Fichier Compose relatif à deploiement/, et nom du projet (préfixe des volumes).
NOORTRACE_COMPOSE=compose/production.yaml
NOORTRACE_PROJET=noortrace
# Variables que production.yaml interpole (CT-8 §8.3).
NOORTRACE_IP_INTERNE=
NOORCORE_CHAIN_ID=
NOORCORE_EVM_CHAIN_ID=
NOORCORE_LEADER_RPC=
# Archives d'exploitation de l'hôte : journal des tâches (taches/taches.ndjson), fichiers tournés
# (journal-exploitation/), contrôles (controles/). L'archive de sauvegarde de 11.2 ne les emporte pas
# (elle n'emporte que le répertoire du journal) : leur copie hors de l'hôte reste à l'outil du client.
NOORTRACE_EXPLOITATION=/srv/noortrace-exploitation
# Supervision (CT-8 §10, EX-10.3, EX-10.9) : répertoire du collecteur textfile de l'exportateur de nœud
# (--collector.textfile.directory), où les tâches écrivent leurs jauges (releve-<check>.prom par
# sonde.mjs releve pour TP-4, TP-5 et la relecture de TP-6 ; tache-<id>.prom : code et fin de chaque
# tâche) et où les services noortrace-extracteur et noortrace-sonde (poser-taches.sh --supervision)
# écrivent extracteur.prom et sonde.prom. Vide : aucune jauge écrite par les tâches.
NOORTRACE_SUPERVISION=@SUPERVISION@
# Services de supervision (superviser.sh) : cadence des passes (secondes), racine des volumes du moteur
# (les journaux lus : <racine>/<projet>_exploitation/_data, <racine>/<projet>_approbation-etat/_data),
# procès-verbaux lus (NOORTRACE_SAUVEGARDES et NOORTRACE_EXPLOITATION/proces-verbaux s'ils existent),
# chemins supplémentaires de l'extracteur (séparés par des espaces : fichier de l'outil de gel,
# acquisitions.ndjson, sorties de l'outil du registre, journal des consultations), et cibles de la sonde.
NOORTRACE_SUPERVISION_INTERVALLE=15
NOORTRACE_VOLUMES=/var/lib/docker/volumes
NOORTRACE_EXTRACTEUR_GEL=
NOORTRACE_EXTRACTEUR_ACQUISITIONS=
NOORTRACE_EXTRACTEUR_REGISTRE=
NOORTRACE_EXTRACTEUR_CONSULTATIONS=
NOORTRACE_SONDE_APPROBATION=http://127.0.0.1:8601
NOORTRACE_SONDE_CONSOLE=
NOORTRACE_SONDE_RPC=
NOORTRACE_SONDE_INSTANCE=
# recorder.instance_id, et nom du journal d'exploitation dans le volume exploitation (TP-6).
NOORTRACE_INSTANCE=
NOORTRACE_OPS_LOG=exploitation.ndjson
# TP-1 : fichier des identifiants du gardien de pose sur l'hôte (mode 0400), et son identité.
NOORTRACE_TP1_IDENTIFIANTS=
NOORTRACE_TP1_IDENTITE=
# TP-2, TP-3, TP-5 : commandes du client (aucun outil du dépôt), exécutées par bash -c.
NOORTRACE_TP2_COMMANDE=
NOORTRACE_TP3_COMMANDE=
NOORTRACE_TP5_COMMANDE=
# TP-4 : fichier des identifiants du Lecteur (mode 0400). Tout le registre des gels est relu (worm gel liste,
# CT-2 EX-12.36) ; NOORTRACE_TP4_GELS (facultatif) nomme des gels relus en plus, un par un (worm gel etat --gel).
NOORTRACE_TP4_IDENTIFIANTS=
NOORTRACE_TP4_GELS=
# TP-8 : point de montage de storage.root, et sortie de dimensionner.mjs (facultative).
NOORTRACE_STOCKAGE=
NOORTRACE_DIMENSIONNEMENT=
# SAUVEGARDE : identifiants du journal, fichier de clés (cles.json de CT-1), répertoire des archives.
NOORTRACE_ORG_ID=
NOORTRACE_JOURNAL_ID=
NOORTRACE_CLES=
NOORTRACE_SAUVEGARDES=/srv/noortrace-sauvegardes
NOORTRACE_SAUVEGARDE_IDENTITE=tache-sauvegarde
