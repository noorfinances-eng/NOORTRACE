# Réglages des tâches planifiées de NOORTRACE (CT-8 EX-8.6, IC-16), lus par
# les unités systemd (EnvironmentFile=/etc/noortrace/taches.env). poser-taches.sh
# copie ce modèle à /etc/noortrace/taches.env s'il n'existe pas (jamais remplacé),
# en mode 0600 : il ne contient aucun secret, seulement des chemins de fichiers.
# Une valeur vide laisse la tâche qui l'exige en échec (code 2 ou 3), ce que
# sa ligne au journal des tâches dit.

# Répertoire d'extraction de l'archive de déploiement (celui qui contient deploiement/ et scripts/).
NOORTRACE_RACINE=@RACINE@
# Fichier Compose relatif à deploiement/, et nom du projet (préfixe des volumes).
NOORTRACE_COMPOSE=compose/production.yaml
NOORTRACE_PROJET=noortrace
# Variables que production.yaml interpole (CT-8 §8.3).
NOORTRACE_IP_INTERNE=
NOORCORE_CHAIN_ID=
NOORCORE_EVM_CHAIN_ID=
NOORCORE_LEADER_RPC=
# Archives d'exploitation de l'hôte, rangées avec le journal et emportées par la sauvegarde :
# journal des tâches (taches/taches.ndjson), fichiers tournés (journal-exploitation/), contrôles (controles/).
NOORTRACE_EXPLOITATION=/srv/noortrace-exploitation
# recorder.instance_id, et nom du journal d'exploitation dans le volume exploitation (TP-6).
NOORTRACE_INSTANCE=
NOORTRACE_OPS_LOG=exploitation.ndjson
# TP-1 : fichier des identifiants du gardien de pose sur l'hôte (mode 0400), et son identité.
NOORTRACE_TP1_IDENTIFIANTS=
NOORTRACE_TP1_IDENTITE=
# TP-2, TP-3, TP-5 : commandes du client (aucun outil du dépôt), exécutées par bash -c.
NOORTRACE_TP2_COMMANDE=
NOORTRACE_TP3_COMMANDE=
NOORTRACE_TP5_COMMANDE=
# TP-4 : fichier des identifiants du Lecteur (mode 0400) et identifiants des gels à relire, séparés par des espaces.
NOORTRACE_TP4_IDENTIFIANTS=
NOORTRACE_TP4_GELS=
# TP-8 : point de montage de storage.root, et sortie de dimensionner.mjs (facultative).
NOORTRACE_STOCKAGE=
NOORTRACE_DIMENSIONNEMENT=
# SAUVEGARDE : identifiants du journal, fichier de clés (cles.json de CT-1), répertoire des archives.
NOORTRACE_ORG_ID=
NOORTRACE_JOURNAL_ID=
NOORTRACE_CLES=
NOORTRACE_SAUVEGARDES=/srv/noortrace-sauvegardes
NOORTRACE_SAUVEGARDE_IDENTITE=tache-sauvegarde
