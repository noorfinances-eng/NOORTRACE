{
  "name": "noortrace",
  "version": "0.1.0",
  "description": "NOORTRACE : registre d'exploitation des périodes de journal et des clés d'enregistreur, sur une instance dédiée de noorcore. Contrats Hardhat, tests et scripts de déploiement.",
  "private": true,
  "type": "module",
  "workspaces": [
    "paquets/*"
  ],
  "scripts": {
    "compile": "npx hardhat --config hardhat.config.mjs compile",
    "test": "npx hardhat --config hardhat.config.mjs test",
    "deploy:dev": "npx hardhat --config hardhat.config.mjs run --network hardhat scripts/deploy/deploy-noortrace.mjs",
    "deploy:noorcore": "npx hardhat --config hardhat.config.mjs run --network noorcore scripts/deploy/deploy-noortrace.mjs",
    "e2e:dev": "npx hardhat --config hardhat.config.mjs run --network hardhat scripts/e2e/dev-roundtrip.mjs",
    "e2e:noorcore": "npx hardhat --config hardhat.config.mjs run --network noorcore scripts/e2e/dev-roundtrip.mjs",
    "verify:certificat": "node scripts/verify/certificat-commit.mjs",
    "verify:dossier": "node scripts/verify/dossier.mjs",
    "verify:ceremonie": "node scripts/verify/ceremonie.mjs",
    "vecteurs:ct1": "node scripts/vecteurs/generer-ct1.mjs",
    "vecteurs:ct2": "node scripts/vecteurs/generer-ct2.mjs",
    "vecteurs:ct3": "node scripts/vecteurs/generer-ct3.mjs",
    "vecteurs:ct4": "node scripts/vecteurs/generer-ct4.mjs",
    "vecteurs:ct5": "node scripts/vecteurs/generer-ct5.mjs",
    "vecteurs:ct6": "node scripts/vecteurs/generer-ct6.mjs",
    "vecteurs:ct7": "node scripts/vecteurs/generer-ct7.mjs",
    "vecteurs:ct8": "node scripts/vecteurs/generer-ct8.mjs",
    "vecteurs:ct9": "node scripts/vecteurs/generer-ct9.mjs",
    "registre": "node scripts/registre/noortrace-registre.mjs",
    "console:empreintes": "node scripts/console/empreintes.mjs",
    "conformite:renvois": "node scripts/conformite/verifier-renvois.mjs",
    "conformite:attestation": "node scripts/conformite/attestation.mjs",
    "tests:couverture": "node scripts/tests/couverture.mjs",
    "mesures:ct9": "node scripts/tests/mesures.mjs",
    "conception:figeage": "node scripts/conception/figeage.mjs",
    "deploiement:conteneurs": "node scripts/deploiement/verifier-conteneurs.mjs deploiement/compose/rapide.yaml deploiement/compose/production.yaml --images deploiement/images/images.json",
    "deploiement:renvois": "node scripts/deploiement/renvois.mjs",
    "deploiement:dimensionner": "node scripts/deploiement/dimensionner.mjs",
    "deploiement:controle": "node scripts/deploiement/controle-prealable.mjs",
    "deploiement:archive": "node scripts/deploiement/construire-archive.mjs",
    "exploitation:verifier-journal": "node scripts/deploiement/verifier-journal.mjs",
    "exploitation:rapport-observation": "node scripts/deploiement/rapport-observation.mjs",
    "exploitation:proces-verbal": "node scripts/deploiement/proces-verbal.mjs",
    "exploitation:consultations": "node scripts/deploiement/consultations.mjs",
    "paquet:construire": "node scripts/paquet-reviseur/construire.mjs",
    "paquet:verifier": "node scripts/paquet-reviseur/verifier.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.3",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.0",
    "chai": "^6.0.1",
    "ethers": "^6.16.0",
    "fast-check": "4.10.2",
    "hardhat": "^3.20.0",
    "js-yaml": "4.3.2",
    "mocha": "^11.7.2"
  }
}
