#!/usr/bin/env node
// noortrace-ctl : actions du lot WORM (CT-2 §12.11, EX-12.36, EX-17.6, voir
// src/worm/ctl.mjs), et commandes adressées au démon en marche, `reload`
// (EX-15.5), `clock --accept` (EX-7.13) et `cle rotation-urgence` (CT-8
// EX-10.14) (voir src/ctl-demon.mjs).
import { principalCtl } from "../src/worm/ctl.mjs";
import { principalCtlDemon } from "../src/ctl-demon.mjs";

const argv = process.argv.slice(2);
const principal = argv[0] === "reload" || argv[0] === "clock" || argv[0] === "cle" ? principalCtlDemon : principalCtl;

principal(argv).then(
  (code) => {
    process.exitCode = code;
  },
  (e) => {
    process.stderr.write(`noortrace-ctl : ${e?.message ?? e}\n`);
    process.exitCode = 1;
  },
);
