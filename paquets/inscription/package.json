{
  "name": "@noortrace/inscription",
  "version": "0.1.0",
  "description": "Inscription des clients NOORTRACE par l'exploitant (CT-4 §7.13, §7.14, révision 0.7) : interface web d'exploitant (Next.js) qui ne tient aucune clé, agent séparé et privilégié joint par une prise AF_UNIX dont il vérifie le compte du pair, travaux typés, dossier inscription-client-v0, confirmations hors bande, production et contrôle du paquet client.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "noortrace-inscription-agent": "bin/noortrace-inscription-agent",
    "noortrace-inscription-web": "bin/noortrace-inscription-web"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./agent": "./src/agent/index.mjs",
    "./client": "./src/agent/client.mjs",
    "./paquet": "./src/commun/paquet.mjs",
    "./travaux": "./src/commun/travaux.mjs",
    "./champs": "./src/commun/champs.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "LISEZMOI.md",
    "INTERFACES.md"
  ],
  "scripts": {
    "construire-interface": "NEXT_TELEMETRY_DISABLED=1 next build src/web"
  },
  "dependencies": {
    "@noortrace/ancrage": "0.1.0",
    "@noortrace/approbation": "0.1.0",
    "@noortrace/noyau": "0.1.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
