{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noortrace.example/schemas/v0/ancres-confiance.schema.json",
  "title": "Ancres de confiance du réviseur, version 0 (CT-6 §12)",
  "description": "Fichier fourni et contrôlé par le réviseur, jamais lu dans le dossier ni sur le réseau. Tout ce qu'il contient est de confiance pour le vérificateur : autorités d'horodatage acceptées et leur statut qualifié déclaré, preuves de non-révocation, point de contrôle Bitcoin, registre (identifiant de chaîne, adresses des contrats, jeux de validateurs par hauteurs), clés d'enregistreur tenues d'ailleurs que du registre. La forme est fixe : toutes les clés sont présentes, à null ou à une liste vide quand elles ne s'appliquent pas.",
  "type": "object",
  "additionalProperties": false,
  "required": [ "version", "label", "prepared_by", "prepared_at", "tsa_authorities", "revocation", "bitcoin", "registry", "recorders" ],
  "properties": {
    "version": { "const": 0 },
    "label": { "$ref": "#/$defs/texte", "description": "Nom de ce jeu d'ancres." },
    "prepared_by": { "$ref": "#/$defs/texte", "description": "Qui a préparé le fichier." },
    "prepared_at": { "$ref": "#/$defs/horodatage" },
    "tsa_authorities": {
      "description": "Autorités d'horodatage acceptées (contrôle 4, T-4, T-7, T-9, T-11).",
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/autorite" }
    },
    "revocation": {
      "description": "Preuves de non-révocation des certificats des chemins de T-7 (T-10).",
      "type": "object",
      "additionalProperties": false,
      "required": [ "crls", "statements" ],
      "properties": {
        "crls": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/pem_crl" } },
        "statements": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/declaration_revocation" } }
      }
    },
    "bitcoin": {
      "description": "Point de contrôle et exigences du contrôle 5 ; null si le réviseur ne fournit pas d'ancre Bitcoin.",
      "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/bitcoin" } ]
    },
    "registry": {
      "description": "Registre de confiance du contrôle 8 ; null si le réviseur ne fournit pas d'ancre de registre.",
      "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/registre" } ]
    },
    "recorders": {
      "description": "Clés d'enregistreur que le réviseur tient d'une autre source que le dossier (N-3).",
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/enregistreur" }
    }
  },
  "$defs": {
    "texte": { "type": "string", "minLength": 1, "maxLength": 512 },
    "hex32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "adresse": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "oid": { "type": "string", "pattern": "^[0-2](\\.(0|[1-9][0-9]*))+$" },
    "identifiant_cle": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "horodatage": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "description": "RFC 3339, UTC, trois décimales, suffixe Z (CT-1 §3) ; la date doit exister, ce que le vérificateur contrôle (N-1)."
    },
    "pem_certificat": {
      "type": "string",
      "maxLength": 65536,
      "pattern": "^-----BEGIN CERTIFICATE-----\\n([A-Za-z0-9+/=]{1,76}\\n)+-----END CERTIFICATE-----\\n?$",
      "description": "Un seul certificat X.509 en PEM, lignes de base64 terminées par un saut de ligne."
    },
    "pem_crl": {
      "type": "string",
      "maxLength": 16777216,
      "pattern": "^-----BEGIN X509 CRL-----\\n([A-Za-z0-9+/=]{1,76}\\n)+-----END X509 CRL-----\\n?$",
      "description": "Une liste de révocation X.509 complète en PEM."
    },
    "autorite": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "certificate", "intermediates", "accepted_policies", "qualified", "source" ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "certificate": { "$ref": "#/$defs/pem_certificat", "description": "Ancre : seuls la clé publique et le nom sujet servent ; peut être une AC intermédiaire ou le certificat de l'unité elle-même." },
        "intermediates": {
          "description": "Certificats d'aide à la construction du chemin ; ils ne sont pas de confiance et sont vérifiés comme ceux du jeton.",
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/pem_certificat" }
        },
        "accepted_policies": {
          "description": "OID de politique d'horodatage admis (T-9) ; null : toute politique.",
          "oneOf": [
            { "type": "null" },
            { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/oid" } }
          ]
        },
        "qualified": {
          "description": "Statut qualifié tel que le réviseur l'a établi (T-11) ; null : aucun statut déclaré.",
          "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/qualification" } ]
        },
        "source": { "$ref": "#/$defs/texte", "description": "D'où le réviseur tient ce certificat (liste de confiance, territoire, numéro de séquence, date)." }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "framework", "valid_from", "valid_to", "source" ],
      "properties": {
        "framework": { "type": "string", "enum": [ "eidas", "zertes" ] },
        "valid_from": { "$ref": "#/$defs/horodatage" },
        "valid_to": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/horodatage" } ] },
        "source": { "$ref": "#/$defs/texte" }
      }
    },
    "declaration_revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "certificate_sha256", "not_revoked_at", "method", "source" ],
      "properties": {
        "certificate_sha256": { "$ref": "#/$defs/hex32", "description": "SHA-256 du DER du certificat visé." },
        "not_revoked_at": { "$ref": "#/$defs/horodatage", "description": "Instant auquel le réviseur a constaté la non-révocation ; doit être postérieur ou égal à genTime pour servir (T-10)." },
        "method": { "type": "string", "enum": [ "ocsp", "crl", "autre" ] },
        "source": { "$ref": "#/$defs/texte" }
      }
    },
    "bitcoin": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "network", "checkpoint", "min_confirmations", "source" ],
      "properties": {
        "network": { "type": "string", "enum": [ "mainnet", "regtest" ] },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "height", "hash" ],
          "properties": {
            "height": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "hash": { "$ref": "#/$defs/hex32", "description": "Hachage du bloc dans l'ordre d'affichage de Bitcoin Core (octets du double SHA-256 inversés), préfixe 0x." }
          }
        },
        "min_confirmations": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "source": { "$ref": "#/$defs/texte" }
      }
    },
    "validateur": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "id", "pubKeyHex" ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pubKeyHex": { "type": "string", "pattern": "^0x([0-9a-f]{66}|[0-9a-f]{128}|[0-9a-f]{130})$", "description": "Clé publique secp256k1 telle que le réseau la configure (65, 64 ou 33 octets) ; le hachage du jeu porte sur ces octets." }
      }
    },
    "jeu_validateurs": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "from_height", "to_height", "validators", "source" ],
      "properties": {
        "from_height": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "to_height": { "oneOf": [ { "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } ] },
        "validators": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/validateur" } },
        "source": { "$ref": "#/$defs/texte" }
      }
    },
    "registre": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "chain_id", "contracts", "validator_sets", "source" ],
      "properties": {
        "chain_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "description": "Identifiant de chaîne BFT (domaine des enveloppes signées), par exemple noortrace-2124-dev." },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "period_registry", "attestation_registry", "recorder_registry" ],
          "properties": {
            "period_registry": { "$ref": "#/$defs/adresse" },
            "attestation_registry": { "$ref": "#/$defs/adresse" },
            "recorder_registry": { "$ref": "#/$defs/adresse" }
          }
        },
        "validator_sets": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/jeu_validateurs" } },
        "source": { "$ref": "#/$defs/texte" }
      }
    },
    "enregistreur": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "org_id", "journal_id", "key_id", "public_key", "chain_key", "source" ],
      "properties": {
        "org_id": { "$ref": "#/$defs/hex32" },
        "journal_id": { "$ref": "#/$defs/hex32" },
        "key_id": { "$ref": "#/$defs/identifiant_cle" },
        "public_key": { "$ref": "#/$defs/hex32", "description": "Clé publique Ed25519 (32 octets)." },
        "chain_key": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/adresse" } ], "description": "Adresse de la clé de chaîne sous laquelle la clé est inscrite (CT-2 EX-11.19), si le réviseur la connaît." },
        "source": { "$ref": "#/$defs/texte" }
      }
    }
  }
}
