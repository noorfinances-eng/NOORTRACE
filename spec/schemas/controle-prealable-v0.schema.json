{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noortrace.example/schemas/v0/controle-prealable.schema.json",
  "title": "Contrôle préalable d'un hôte NOORTRACE (CT-8 §6)",
  "description": "Racine : le rapport de scripts/deploiement/controle-prealable.mjs (--json). $defs/observations : ce que la collecte a relevé sur l'hôte ; $defs/exigences : les seuils d'un profil ; $defs/cas : un fichier de cas de la famille ct-8/controle-prealable. Aucun nom d'hôte, aucun secret, aucune adresse autre que celles que la collecte a résolues.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "checked_at", "tool", "verdict", "exit_code", "checks"],
  "properties": {
    "version": { "const": 0 },
    "profile": { "$ref": "#/$defs/profil" },
    "checked_at": { "$ref": "#/$defs/horodatage" },
    "tool": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "verdict": { "enum": ["pret", "pret_avec_avertissements", "non_pret"] },
    "exit_code": { "enum": [0, 1] },
    "checks": { "type": "array", "minItems": 13, "maxItems": 13, "items": { "$ref": "#/$defs/verification" } }
  },
  "$defs": {
    "profil": { "enum": ["rapide", "production"] },
    "horodatage": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "octets": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "valeur": {
      "description": "Valeur mesurée ou attendue : scalaire, liste ou objet de scalaires, jamais un secret.",
      "anyOf": [
        { "type": "string", "maxLength": 1024 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "maxItems": 256 },
        { "type": "object", "maxProperties": 32 }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason", "measured", "expected", "blocking"],
      "properties": {
        "id": { "enum": ["IP-1", "IP-2", "IP-3", "IP-4", "IP-5", "IP-6", "IP-7", "IP-8", "IP-9", "IP-10", "IP-11", "IP-12", "IP-13"] },
        "status": { "enum": ["reussi", "echoue", "avertissement", "non_execute"] },
        "reason": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["mesure_absente", "systeme_non_pris_en_charge", "architecture_non_prise_en_charge", "processeurs_insuffisants", "memoire_insuffisante", "dimensionnement_absent", "espace_insuffisant", "systeme_de_fichiers_refuse", "systeme_de_fichiers_non_eprouve", "outil_absent", "horloge_non_synchronisee", "borne_inconnue", "ecart_trop_grand", "port_occupe", "adresse_toutes_interfaces", "adresse_hors_hote", "nom_non_resolu", "dns", "refus", "delai", "tls", "mandataire", "mandataire_incoherent", "secrets_lisibles", "secret_mode_non_conforme", "secret_partage_entre_comptes", "secret_proprietaire_incorrect", "configuration_lisible_par_autrui", "configuration_proprietaire_incorrect", "non_demandee", "moteur_absent", "compose_absent", "fichier_absent", "conteneurs_non_conformes", "condense_requis", "declaration_absente"] }
          ]
        },
        "measured": { "oneOf": [{ "type": "null" }, { "type": "object", "maxProperties": 16, "additionalProperties": { "$ref": "#/$defs/valeur" } }] },
        "expected": { "type": "object", "maxProperties": 16, "additionalProperties": { "$ref": "#/$defs/valeur" } },
        "blocking": { "type": "boolean" }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "checked_at", "tool", "platform", "arch", "cpus", "memory_bytes", "storage", "clock", "ports", "dns", "egress", "proxy", "rights", "engine", "compose", "declarations"],
      "properties": {
        "version": { "const": 0 },
        "checked_at": { "$ref": "#/$defs/horodatage" },
        "tool": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "platform": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z0-9]{1,32}$" }], "description": "os.platform() de Node.js." },
        "arch": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z0-9]{1,32}$" }], "description": "os.arch() de Node.js." },
        "cpus": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "memory_bytes": { "$ref": "#/$defs/octets" },
        "storage": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "fstype", "free_bytes"],
              "properties": {
                "path": { "type": "string", "pattern": "^/[^\\u0000]{0,4095}$" },
                "fstype": { "type": "string", "pattern": "^[a-z0-9._-]{1,32}$" },
                "free_bytes": { "$ref": "#/$defs/octets" }
              }
            }
          ]
        },
        "clock": {
          "type": ["object", "null"],
          "description": "null : horloge non relevée (IP-5 non demandée) ; IP-5 est alors non exécutée, raison mesure_absente.",
          "additionalProperties": false,
          "required": ["source", "synchronized", "error_bound_ms"],
          "properties": {
            "source": { "enum": ["chrony", "timedatectl", "timesyncd", "aucune"] },
            "synchronized": { "oneOf": [{ "type": "null" }, { "type": "boolean" }] },
            "error_bound_ms": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] }
          }
        },
        "internal_address": {
          "description": "Adresse interne de production (NOORTRACE_IP_INTERNE ou --ip-interne) et sa présence parmi les adresses des interfaces de l'hôte (IP-6) ; null ou absent en profil rapide et sans adresse interne dans le fichier Compose.",
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["address", "on_host"], "properties": { "address": { "type": "string", "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|\\[?[0-9a-fA-F:]+\\]?)$" }, "on_host": { "type": "boolean" } } }
          ]
        },
        "ports": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["address", "port", "free"],
            "properties": {
              "address": { "type": "string", "pattern": "^(127\\.0\\.0\\.1|[0-9]{1,3}(\\.[0-9]{1,3}){3}|\\[?[0-9a-fA-F:]+\\]?)$" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "free": { "type": "boolean" }
            }
          }
        },
        "dns": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "addresses"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9.-]{1,253}$" },
              "addresses": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 2, "maxLength": 45 } }
            }
          }
        },
        "egress": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["flow", "host", "port", "result"],
            "properties": {
              "flow": { "type": "string", "pattern": "^FL-[1-9][0-9]{0,2}$" },
              "host": { "type": "string", "pattern": "^[A-Za-z0-9.:\\[\\]-]{1,253}$" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "result": { "enum": ["ouvert", "dns", "refus", "delai", "tls", "mandataire"] }
            }
          }
        },
        "proxy": {
          "type": "object", "additionalProperties": false, "required": ["declared", "environment_set"],
          "properties": { "declared": { "type": "boolean" }, "environment_set": { "type": "boolean" } }
        },
        "rights": {
          "type": "object", "additionalProperties": false, "required": ["uid", "secrets_dir_mode", "secret_files", "config_mode", "config_uid", "config_expected_uid"],
          "properties": {
            "uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "secrets_dir_mode": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 4095 }] },
            "secret_files": {
              "type": "array", "maxItems": 128,
              "items": { "type": "object", "additionalProperties": false, "required": ["name", "mode", "uid", "expected_uid"], "properties": { "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }, "mode": { "type": "integer", "minimum": 0, "maximum": 4095 }, "uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "expected_uid": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 4294967295 }], "description": "UID du service qui reçoit le secret, tiré de deploiement/images/images.json ; null quand des services de comptes différents l'admettent (un fichier n'a qu'un propriétaire : IP-10 échoue, secret_partage_entre_comptes)." } } }
            },
            "config_mode": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 4095 }] },
            "config_uid": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 4294967295 }] },
            "config_expected_uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          }
        },
        "engine": {
          "type": "object", "additionalProperties": false, "required": ["engine_ok", "compose_ok"],
          "properties": { "engine_ok": { "type": "boolean" }, "compose_ok": { "type": "boolean" } }
        },
        "compose": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false, "required": ["file_sha256", "failed", "all_images_by_digest"],
              "properties": {
                "file_sha256": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
                "failed": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^CO-[1-9][0-9]?$" } },
                "all_images_by_digest": { "type": "boolean" }
              }
            }
          ]
        },
        "declarations": {
          "type": "object", "additionalProperties": false, "required": ["write_cache_protected"],
          "properties": { "write_cache_protected": { "type": "boolean", "description": "Déclaration de l'exploitant (option --declare cache-protege) : stockage à cache d'écriture protégé ou qui honore les vidages (CT-2 EX-12.9)." } }
        }
      }
    },
    "cas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "profile", "observations", "attendu"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "profile": { "$ref": "#/$defs/profil" },
        "storage_free_min_bytes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/octets" }], "description": "Seuil d'IP-3 tiré d'un dimensionnement (sortie local_bytes de CT-8 §9), quand le cas en fixe un." },
        "only": { "type": "array", "uniqueItems": true, "minItems": 1, "maxItems": 13, "items": { "type": "string", "pattern": "^IP-([1-9]|1[0-3])$" }, "description": "Option --seulement : vérifications demandées ; les autres sont non_execute, raison non_demandee, non bloquantes." },
        "observations": { "$ref": "#/$defs/observations" },
        "attendu": { "$ref": "#" }
      }
    }
  }
}
