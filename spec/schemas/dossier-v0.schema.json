                }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/part",
              "properties": {
                "name": {
                  "const": "manifeste_sig"
                },
                "file": {
                  "const": "manifeste.sig"
                },
                "present": {
                  "const": true
                }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/part",
              "properties": {
                "name": {
                  "const": "cles"
                },
                "file": {
                  "const": "cles.json"
                },
                "present": {
                  "const": true
                }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/part",
              "properties": {
                "name": {
                  "const": "approbations"
                },
                "file": {
                  "const": "approbations.json"
                }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/part",
              "properties": {
                "name": {
                  "const": "jeton_rfc3161"
                },
                "file": {
                  "const": "jeton-rfc3161.der"
                }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/part",
              "properties": {
                "name": {
                  "const": "preuve_ots"
                },
                "file": {
                  "const": "preuve.ots"
                }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/part",
              "properties": {
                "name": {
                  "const": "registre"
                },
                "file": {
                  "const": "registre.json"
                }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/part",
              "properties": {
                "name": {
                  "const": "certificat_commit"
                },
                "file": {
                  "const": "certificat-commit.json"
                }
              }
            },
            {
