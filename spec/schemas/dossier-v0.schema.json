                }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/part",
              "properties": {
                "name": {
                  "const": "chemin"
                },
                "file": {
                  "const": "chemin.json"
                },
                "present": {
                  "const": true
                }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/part",
              "properties": {
                "name": {
                  "const": "manifeste"
                },
                "file": {
                  "const": "manifeste.json"
                },
                "present": {
