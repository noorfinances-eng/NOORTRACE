                  "const": "points_de_controle"
                },
                "file": {
                  "const": "points-de-controle.json"
                }
              }
            }
          ]
        },
        {
          "minItems": 14,
          "maxItems": 14,
          "items": false,
          "prefixItems": [
            {
              "type": "object",
              "$ref": "#/$defs/part",
              "properties": {
                "name": {
                  "const": "evenement"
                },
                "file": {
                  "const": "evenement.json"
                },
