{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noortrace.example/schemas/v0/dossier.schema.json",
  "title": "Dossier de preuve NOORTRACE, version 0 : index dossier.json et fichiers compagnons",
  "description": "Le schéma principal décrit l'index dossier.json. Les $defs voisins, chemin, manifeste_sig, cles et approbations décrivent les fichiers compagnons du même répertoire ; evenement.json se valide contre le schéma d'événement et manifeste.json contre le schéma de manifeste. Les douze parties sont toujours déclarées, dans cet ordre, présentes ou absentes avec leur raison.",
  "type": "object",
  "additionalProperties": false,
  "required": [ "version", "event", "org_id", "journal_id", "generated_at", "parts" ],
  "properties": {
    "version": { "const": 0 },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "seq", "hash" ],
      "properties": {
        "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "hash": { "$ref": "#/$defs/hex32" }
      }
    },
    "org_id": { "$ref": "#/$defs/hex32" },
    "journal_id": { "$ref": "#/$defs/hex32" },
    "generated_at": { "$ref": "#/$defs/horodatage" },
    "parts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": false,
      "prefixItems": [
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "evenement" }, "file": { "const": "evenement.json" }, "present": { "const": true } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "voisins" }, "file": { "const": "voisins.json" }, "present": { "const": true } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "chemin" }, "file": { "const": "chemin.json" }, "present": { "const": true } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "manifeste" }, "file": { "const": "manifeste.json" }, "present": { "const": true } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "manifeste_sig" }, "file": { "const": "manifeste.sig" }, "present": { "const": true } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "cles" }, "file": { "const": "cles.json" }, "present": { "const": true } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "approbations" }, "file": { "const": "approbations.json" } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "jeton_rfc3161" }, "file": { "const": "jeton-rfc3161.der" } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "preuve_ots" }, "file": { "const": "preuve.ots" } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "registre" }, "file": { "const": "registre.json" } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "certificat_commit" }, "file": { "const": "certificat-commit.json" } } },
        { "type": "object", "$ref": "#/$defs/part", "properties": { "name": { "const": "validateurs" }, "file": { "const": "validateurs.json" } } }
      ]
    }
  },
  "$defs": {
    "hex32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "horodatage": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "description": "RFC 3339, UTC, trois décimales, suffixe Z ; la date doit exister dans le calendrier grégorien proleptique (CT-1 §3), ce que le motif n'exprime pas et que le vérificateur contrôle."
    },
    "identifiant_cle": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "adresse": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "signature_ed25519": { "type": "string", "pattern": "^0x[0-9a-f]{128}$" },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "file", "sha256", "present", "reason_if_absent" ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [ "evenement", "voisins", "chemin", "manifeste", "manifeste_sig", "cles", "approbations", "jeton_rfc3161", "preuve_ots", "registre", "certificat_commit", "validateurs" ]
        },
        "file": {
          "type": "string",
          "enum": [ "evenement.json", "voisins.json", "chemin.json", "manifeste.json", "manifeste.sig", "cles.json", "approbations.json", "jeton-rfc3161.der", "preuve.ots", "registre.json", "certificat-commit.json", "validateurs.json" ]
        },
        "sha256": { "oneOf": [ { "$ref": "#/$defs/hex32" }, { "type": "null" } ], "description": "SHA-256 des octets du fichier tel qu'il est dans le répertoire ; null si absent." },
        "present": { "type": "boolean" },
        "reason_if_absent": { "type": [ "string", "null" ], "minLength": 1, "maxLength": 256 }
      },
      "if": { "properties": { "present": { "const": true } } },
      "then": { "properties": { "sha256": { "$ref": "#/$defs/hex32" }, "reason_if_absent": { "type": "null" } } },
      "else": { "properties": { "sha256": { "type": "null" }, "reason_if_absent": { "type": "string" } } }
    },
    "voisins": {
      "title": "voisins.json",
      "description": "L'événement précédent et l'événement suivant, complets, ou null quand ils n'existent pas (premier événement du journal ; dernier événement connu).",
      "type": "object",
      "additionalProperties": false,
      "required": [ "version", "previous", "next" ],
      "properties": {
        "version": { "const": 0 },
        "previous": { "oneOf": [ { "$ref": "https://noortrace.example/schemas/v0/evenement.schema.json" }, { "type": "null" } ] },
        "next": { "oneOf": [ { "$ref": "https://noortrace.example/schemas/v0/evenement.schema.json" }, { "type": "null" } ] }
      }
    },
    "chemin": {
      "title": "chemin.json",
      "description": "Preuve d'inclusion RFC 6962 §2.1.1 : taille de l'arbre, indice de la feuille (seq - first_seq), hachage de la feuille, chemin d'audit de la feuille vers la racine, racine attendue.",
      "type": "object",
      "additionalProperties": false,
      "required": [ "version", "tree_size", "leaf_index", "leaf_hash", "path", "root" ],
      "properties": {
        "version": { "const": 0 },
        "tree_size": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "leaf_index": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
        "leaf_hash": { "$ref": "#/$defs/hex32" },
        "path": { "type": "array", "items": { "$ref": "#/$defs/hex32" }, "maxItems": 64 },
        "root": { "$ref": "#/$defs/hex32" }
      }
    },
    "manifeste_sig": {
      "title": "manifeste.sig",
      "description": "Signature Ed25519 du manifeste par l'enregistreur : Ed25519(clé recorder_key_id, \"noortrace/signature-manifeste/v0\\n\" || JCS(manifeste)).",
      "type": "object",
      "additionalProperties": false,
      "required": [ "version", "period_hash", "recorder_key_id", "sig" ],
      "properties": {
        "version": { "const": 0 },
        "period_hash": { "$ref": "#/$defs/hex32" },
        "recorder_key_id": { "$ref": "#/$defs/identifiant_cle" },
        "sig": { "$ref": "#/$defs/signature_ed25519" }
      }
    },
    "cle_enregistreur": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "key_id", "algorithm", "public_key", "valid_from", "valid_to", "source" ],
      "properties": {
        "key_id": { "$ref": "#/$defs/identifiant_cle" },
        "algorithm": { "const": "ed25519" },
        "public_key": { "$ref": "#/$defs/hex32", "description": "Clé publique Ed25519, 32 octets (RFC 8032)." },
        "valid_from": { "$ref": "#/$defs/horodatage" },
        "valid_to": { "oneOf": [ { "$ref": "#/$defs/horodatage" }, { "type": "null" } ], "description": "Fin de validité annoncée (incluse), null si la clé est encore en service ; sinon supérieure ou égale à valid_from (contrôle E-8 du vérificateur)." },
        "source": { "type": "string", "minLength": 1, "maxLength": 256, "description": "D'où vient l'annonce de validité : registre (CT-4), événement de rotation, onboarding, vecteurs." }
      }
    },
    "cles": {
      "title": "cles.json",
      "description": "Les clés publiques Ed25519 de l'enregistreur nécessaires au dossier, avec leur période de validité telle qu'annoncée. org_id et journal_id sont ceux de l'événement prouvé ; key_id et public_key sont uniques dans keys (unicité d'un sous-champ, non exprimable ici : contrôle E-8 du vérificateur, CT-1 §11.2).",
      "type": "object",
      "additionalProperties": false,
      "required": [ "version", "org_id", "journal_id", "keys" ],
      "properties": {
        "version": { "const": 0 },
        "org_id": { "$ref": "#/$defs/hex32" },
        "journal_id": { "$ref": "#/$defs/hex32" },
        "keys": { "type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "#/$defs/cle_enregistreur" } }
      }
    },
    "approbations": {
      "title": "approbations.json",
      "description": "Les événements d'approbation liés au ticket de l'événement prouvé, avec le jeu d'approbateurs déclaré et son seuil. Quand l'événement prouvé n'a pas d'approbation, le fichier est absent (reason_if_absent = \"aucune approbation liée\"). Pour le dossier d'une décision, events contient l'événement prouvé lui-même (CT-1 §11.4, A-2).",
      "type": "object",
      "additionalProperties": false,
      "required": [ "version", "ticket", "request_hash", "approver_set", "events" ],
      "properties": {
        "version": { "const": 0 },
        "ticket": { "type": "string", "minLength": 1, "maxLength": 128 },
        "request_hash": { "$ref": "#/$defs/hex32" },
        "approver_set": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "threshold", "members", "source" ],
          "properties": {
            "threshold": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "required", "size" ],
              "properties": {
                "required": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "size": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            },
            "members": { "type": "array", "minItems": 1, "maxItems": 65535, "uniqueItems": true, "items": { "$ref": "#/$defs/adresse" } },
            "source": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "https://noortrace.example/schemas/v0/evenement.schema.json" }
        }
      }
    }
  }
}
