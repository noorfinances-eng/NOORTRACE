{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noortrace.example/schemas/v0/evenement.schema.json",
  "title": "Événement de journal NOORTRACE, version 0",
  "description": "Un événement signé et chaîné du journal d'un enregistreur NOORTRACE : enveloppe (version, seq, ts, org_id, journal_id, recorder_key_id, prev_hash, hash, sig) et les huit champs du modèle. Spécification : spec/CT-1-evenements-et-formats.md. Les contraintes qu'un schéma ne peut pas exprimer (hash et sig recalculés, chaînage, longueurs égales des tableaux approvers et signatures) sont celles du vérificateur.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "seq", "ts", "org_id", "journal_id", "recorder_key_id", "prev_hash",
    "delegation", "code", "intent", "policy", "approval", "execution", "effects", "context",
    "hash", "sig"
  ],
  "properties": {
    "version": { "const": 0, "description": "Version du format d'événement." },
    "seq": { "$ref": "#/$defs/seq", "description": "Numéro de séquence dans le journal, entier strictement positif, incrémenté de 1 à chaque événement." },
    "ts": { "$ref": "#/$defs/horodatage", "description": "Instant de l'événement selon l'horloge de l'enregistreur, RFC 3339 UTC avec millisecondes." },
    "org_id": { "$ref": "#/$defs/hex32", "description": "Identifiant de l'organisation (bytes32), celui de RecorderRegistry et PeriodRegistry." },
    "journal_id": { "$ref": "#/$defs/hex32", "description": "Identifiant du journal (bytes32), jamais nul." },
    "recorder_key_id": { "$ref": "#/$defs/identifiant_cle", "description": "Identifiant de la clé Ed25519 de l'enregistreur qui a produit sig." },
    "prev_hash": { "$ref": "#/$defs/hex32", "description": "hash de l'événement précédent du journal ; 32 octets nuls pour seq = 1." },
    "delegation": { "$ref": "#/$defs/delegation" },
    "code": { "$ref": "#/$defs/code" },
    "intent": {
      "description": "Ce que l'agent déclare vouloir faire : texte, ou référence si volumineux ou rédigé, ou null.",
      "oneOf": [
        { "type": "string", "maxLength": 4096 },
        { "$ref": "#/$defs/reference" },
        { "type": "null" }
      ]
    },
    "policy": { "$ref": "#/$defs/policy" },
    "approval": {
      "description": "Décision d'approbation humaine liée à l'événement, ou null.",
      "oneOf": [ { "$ref": "#/$defs/approval" }, { "type": "null" } ]
    },
    "execution": { "$ref": "#/$defs/execution" },
    "effects": {
      "type": "array",
      "description": "Ressources lues, écrites, supprimées, envoyées ou exécutées. Vide si aucun effet.",
      "items": { "$ref": "#/$defs/effect" },
      "maxItems": 1024
    },
    "context": {
      "type": "array",
      "description": "Provenance du contexte : références aux documents, données et mémoire utilisés.",
      "items": { "$ref": "#/$defs/context_item" },
      "maxItems": 1024
    },
    "hash": { "$ref": "#/$defs/hex32", "description": "SHA-256(\"noortrace/evenement/v0\\n\" || JCS(événement sans hash ni sig))." },
    "sig": { "$ref": "#/$defs/signature_ed25519", "description": "Ed25519(clé recorder_key_id, \"noortrace/signature-evenement/v0\\n\" || JCS(événement sans hash ni sig))." }
  },
  "$defs": {
    "hex32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "description": "32 octets en hexadécimal minuscule préfixé 0x (66 caractères)."
    },
    "signature_ed25519": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{128}$",
      "description": "Signature Ed25519 de 64 octets en hexadécimal minuscule préfixé 0x (130 caractères)."
    },
    "signature_eip191": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{130}$",
      "description": "Signature secp256k1 EIP-191 de 65 octets r || s || v (v = 0x1b ou 0x1c), hexadécimal minuscule préfixé 0x (132 caractères)."
    },
    "adresse": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$",
      "description": "Adresse Ethereum de 20 octets, hexadécimal minuscule préfixé 0x (sans somme de contrôle EIP-55)."
    },
    "horodatage": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "description": "RFC 3339, UTC, exactement trois décimales de seconde, suffixe Z. Les secondes intercalaires ne sont pas représentées. La date doit exister dans le calendrier grégorien proleptique (CT-1 §3) : le motif ne l'exprime pas, le vérificateur refuse (E-1) un horodatage qui respecte le motif mais ne se décode pas (30 février, 31 avril, 29 février hors année bissextile)."
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "entier_positif_ou_nul": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identifiant_cle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "nom_outil": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "description": "Nom d'outil MCP tel qu'annoncé par tools/list, ou nom réservé noortrace.* pour les événements qui ne sont pas des appels d'outil."
    },
    "type_mime": {
      "type": "string",
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
      "maxLength": 127
    },
    "reference": {
      "type": "object",
      "description": "Référence à une pièce conservée chez le client : SHA-256 de ses octets tels que stockés, longueur en octets, drapeau de rédaction. value porte la pièce en ligne quand elle est petite et non rédigée ; la pièce est alors JCS(value). media_type et value sont absentes quand elles ne s'appliquent pas, jamais null (CT-1 §3).",
      "additionalProperties": false,
      "required": [ "sha256", "length", "redacted" ],
      "properties": {
        "sha256": { "$ref": "#/$defs/hex32" },
        "length": { "$ref": "#/$defs/entier_positif_ou_nul" },
        "redacted": { "type": "boolean" },
        "media_type": { "$ref": "#/$defs/type_mime" },
        "value": { "description": "Valeur JSON en ligne, conforme à JCS v0 (aucun nombre non entier)." }
      },
      "if": { "properties": { "redacted": { "const": true } } },
      "then": { "properties": { "value": false } }
    },
    "context_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "sha256", "length", "redacted", "kind" ],
      "properties": {
        "sha256": { "$ref": "#/$defs/hex32" },
        "length": { "$ref": "#/$defs/entier_positif_ou_nul" },
        "redacted": { "type": "boolean" },
        "kind": { "type": "string", "enum": [ "document", "donnees", "memoire", "autre" ] },
        "media_type": { "$ref": "#/$defs/type_mime" }
      }
    },
    "delegation": {
      "type": "object",
      "description": "Provenance de la délégation : qui a lancé l'agent, pour le compte de qui, avec quels droits.",
      "additionalProperties": false,
      "required": [ "launched_by", "on_behalf_of", "scope", "run_id" ],
      "properties": {
        "launched_by": { "type": "string", "minLength": 1, "maxLength": 256 },
        "on_behalf_of": { "type": [ "string", "null" ], "maxLength": 256 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "run_id": { "type": [ "string", "null" ], "maxLength": 128 }
      }
    },
    "code": {
      "type": "object",
      "description": "Provenance du code : version du modèle, du prompt système, de la politique et de l'enregistreur.",
      "additionalProperties": false,
      "required": [ "model", "prompt_version", "policy_version", "recorder" ],
      "properties": {
        "model": { "type": [ "string", "null" ], "maxLength": 256 },
        "prompt_version": { "oneOf": [ { "$ref": "#/$defs/hex32" }, { "type": "null" } ] },
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recorder": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "policy": {
      "type": "object",
      "description": "Évaluation de politique : règle appliquée, décision, ticket d'approbation, règle de rédaction appliquée aux pièces.",
      "additionalProperties": false,
      "required": [ "rule", "decision", "ticket", "redaction" ],
      "properties": {
        "rule": { "type": [ "string", "null" ], "maxLength": 1024 },
        "decision": { "type": "string", "enum": [ "autorise", "a_approuver", "refuse", "sans_objet" ] },
        "ticket": { "type": [ "string", "null" ], "maxLength": 128 },
        "redaction": { "type": [ "string", "null" ], "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "a_approuver" } } },
          "then": { "properties": { "rule": { "type": "string" }, "ticket": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "decision": { "const": "sans_objet" } } },
          "then": { "properties": { "rule": { "type": "null" } } }
        }
      ]
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "required", "size" ],
      "properties": {
        "required": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "size": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "approval": {
      "type": "object",
      "description": "Décision d'approbation humaine : décision, ticket, hachage de l'événement de demande, seuil, approbateurs, signatures EIP-191 (approvers[i] a produit signatures[i]), instant, motif.",
      "additionalProperties": false,
      "required": [ "decision", "ticket", "request_hash", "threshold", "approvers", "signatures", "at", "reason" ],
      "properties": {
        "decision": { "type": "string", "enum": [ "approuve", "refuse", "expire" ] },
        "ticket": { "type": "string", "minLength": 1, "maxLength": 128 },
        "request_hash": { "$ref": "#/$defs/hex32" },
        "threshold": { "$ref": "#/$defs/threshold" },
        "approvers": { "type": "array", "items": { "$ref": "#/$defs/adresse" }, "uniqueItems": true, "maxItems": 65535 },
        "signatures": { "type": "array", "items": { "$ref": "#/$defs/signature_eip191" }, "maxItems": 65535 },
        "at": { "$ref": "#/$defs/horodatage" },
        "reason": { "type": [ "string", "null" ], "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "expire" } } },
          "then": { "properties": { "approvers": { "type": "array", "maxItems": 0 }, "signatures": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "decision": { "const": "approuve" } } },
          "then": { "properties": { "approvers": { "type": "array", "minItems": 1 }, "signatures": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "execution": {
      "type": "object",
      "description": "Exécution : outil, arguments (référence), statut, résultat (référence), durée, erreur. L'allOf porte la table par sorte de CT-1 §5.3 : result, duration_ms et is_error sont obligatoires (non nuls) pour un appel d'outil exécuté et pour un échange avec le modèle, nuls pour un appel retenu ou refusé et pour les trois autres événements réservés (décision d'approbation, rotation de clé, changement de politique).",
      "additionalProperties": false,
      "required": [ "tool", "arguments", "status", "result", "duration_ms", "is_error" ],
      "properties": {
        "tool": { "$ref": "#/$defs/nom_outil" },
        "arguments": { "$ref": "#/$defs/reference" },
        "status": { "type": "string", "enum": [ "executee", "retenue", "refusee" ] },
        "result": { "oneOf": [ { "$ref": "#/$defs/reference" }, { "type": "null" } ] },
        "duration_ms": { "oneOf": [ { "$ref": "#/$defs/entier_positif_ou_nul" }, { "type": "null" } ] },
        "is_error": { "type": [ "boolean", "null" ] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": [ "retenue", "refusee" ] } } },
          "then": { "properties": { "result": { "type": "null" }, "duration_ms": { "type": "null" }, "is_error": { "type": "null" } } }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "executee" },
              "tool": { "type": "string", "anyOf": [ { "not": { "pattern": "^noortrace\\." } }, { "const": "noortrace.modele.echange" } ] }
            }
          },
          "then": { "properties": { "result": { "$ref": "#/$defs/reference" }, "duration_ms": { "type": "integer" }, "is_error": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "tool": { "type": "string", "enum": [ "noortrace.approbation.decision", "noortrace.journal.rotation-cle", "noortrace.journal.politique" ] } } },
          "then": { "properties": { "result": { "type": "null" }, "duration_ms": { "type": "null" }, "is_error": { "type": "null" } } }
        },
        {
          "if": { "properties": { "tool": { "type": "string", "pattern": "^noortrace\\." } } },
          "then": { "properties": { "tool": { "type": "string", "enum": [ "noortrace.modele.echange", "noortrace.approbation.decision", "noortrace.journal.rotation-cle", "noortrace.journal.politique" ] } } }
        }
      ]
    },
    "effect": {
      "type": "object",
      "description": "Un effet sur un système du client. amount et currency sont tous deux null ou tous deux renseignés.",
      "additionalProperties": false,
      "required": [ "system", "action", "object", "amount", "currency" ],
      "properties": {
        "system": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action": { "type": "string", "enum": [ "lecture", "ecriture", "suppression", "envoi", "execution" ] },
        "object": { "type": "string", "minLength": 1, "maxLength": 512 },
        "amount": { "type": [ "string", "null" ], "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$" },
        "currency": { "type": [ "string", "null" ], "pattern": "^[A-Z]{3}$" }
      },
      "allOf": [
        { "if": { "properties": { "amount": { "type": "null" } } }, "then": { "properties": { "currency": { "type": "null" } } } },
        { "if": { "properties": { "amount": { "type": "string" } } }, "then": { "properties": { "currency": { "type": "string" } } } }
      ]
    }
  }
}
