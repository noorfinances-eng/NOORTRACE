{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noortrace.example/schemas/v0/matrice-conformite.schema.json",
  "title": "Matrice de conformité NOORTRACE, version 0 (CT-7 §8)",
  "description": "Correspondance technique entre des passages de textes (lois, ordonnances, règlements, circulaires, recommandations) et les pièces de preuve que NOORTRACE produit. Ce n’est pas un avis juridique. Chaque ligne cite exactement un passage d’une source primaire datée, dit ce qui est exigé et, élément par élément, si une pièce y répond, y contribue, ne le couvre pas, ou s’il relève du client ; le statut de la ligne se dérive des relations (CT-7 EX-8.4), règle que le schéma porte. Les pièces renvoient à des définitions des spécifications CT-1 à CT-7 ; leur existence est vérifiée par scripts/conformite/verifier-renvois.mjs, pas par ce schéma.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "family",
    "spec",
    "spec_version",
    "date",
    "warning",
    "texts",
    "rows",
    "clauses",
    "gaps"
  ],
  "properties": {
    "version": {
      "const": 0
    },
    "family": {
      "const": "matrice-conformite"
    },
    "spec": {
      "const": "CT-7"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "warning": {
      "const": "Cette matrice établit une correspondance technique entre des passages de textes et des pièces de preuve produites par NOORTRACE. Elle n'est pas un avis juridique et ne dit jamais qu'un client est conforme : la qualification du client, l'applicabilité de chaque texte et la conformité relèvent du client et de ses conseils."
    },
    "texts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/texte"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ligne"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clause"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lacune"
      }
    }
  },
  "$defs": {
    "texte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "title",
        "nature",
        "version",
        "url",
        "read_on",
        "addressee",
        "applicability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T-[1-9][0-9]*$"
        },
        "source": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "nature": {
          "enum": [
            "loi",
            "ordonnance",
            "reglement_ue",
            "reglement_delegue_ue",
            "circulaire",
            "communication_surveillance",
            "recommandation"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "maxLength": 512
        },
        "read_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "addressee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "applicability": {
          "$ref": "#/$defs/applicabilite"
        }
      }
    },
    "applicabilite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "from",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "en_vigueur",
            "vigueur_a_confirmer",
            "pas_encore_applicable",
            "publie"
          ]
        },
        "from": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "scope"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "pas_encore_applicable"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "from": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "ligne": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "reference",
        "facts",
        "quote",
        "source_url",
        "read_on",
        "requirement",
        "applicability",
        "elements",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MC-[1-9][0-9]*$"
        },
        "text": {
          "type": "string",
          "pattern": "^T-[1-9][0-9]*$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^R[0-9]+-F[1-9][0-9]*$"
          }
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "maxLength": 512
        },
        "read_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "applicability": {
          "enum": [
            "en_vigueur",
            "vigueur_a_confirmer",
            "pas_encore_applicable",
            "publie"
          ]
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "status": {
          "enum": [
            "couvert",
            "partiel",
            "hors_perimetre"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "hors_perimetre"
              }
            }
          },
          "then": {
            "properties": {
              "elements": {
                "type": "array",
                "not": {
                  "contains": {
                    "type": "object",
                    "required": [
                      "relation"
                    ],
                    "properties": {
                      "relation": {
                        "enum": [
                          "repond_a",
                          "contribue_a"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "couvert"
              }
            }
          },
          "then": {
            "properties": {
              "elements": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "relation",
                    "condition"
                  ],
                  "properties": {
                    "relation": {
                      "const": "repond_a"
                    },
                    "condition": {
                      "type": "null"
                    }
                  }
                },
                "not": {
                  "contains": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "relation"
                        ],
                        "properties": {
                          "relation": {
                            "enum": [
                              "contribue_a",
                              "ne_couvre_pas"
                            ]
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "relation",
                          "condition"
                        ],
                        "properties": {
                          "relation": {
                            "const": "repond_a"
                          },
                          "condition": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "partiel"
              }
            }
          },
          "then": {
            "properties": {
              "elements": {
                "type": "array",
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "relation"
                      ],
                      "properties": {
                        "relation": {
                          "enum": [
                            "repond_a",
                            "contribue_a"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "relation"
                          ],
                          "properties": {
                            "relation": {
                              "enum": [
                                "contribue_a",
                                "ne_couvre_pas"
                              ]
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "relation",
                            "condition"
                          ],
                          "properties": {
                            "relation": {
                              "const": "repond_a"
                            },
                            "condition": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element",
        "relation",
        "pieces",
        "condition"
      ],
      "properties": {
        "element": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "relation": {
          "enum": [
            "repond_a",
            "contribue_a",
            "ne_couvre_pas",
            "releve_du_client"
          ]
        },
        "pieces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/piece"
          }
        },
        "condition": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "relation"
            ],
            "properties": {
              "relation": {
                "enum": [
                  "repond_a",
                  "contribue_a"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "pieces": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "piece": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "spec",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exigence",
            "verification",
            "controle",
            "partie",
            "section",
            "clause"
          ]
        },
        "spec": {
          "enum": [
            "CT-1",
            "CT-2",
            "CT-3",
            "CT-4",
            "CT-5",
            "CT-6",
            "CT-7"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "exigence"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^EX-[0-9A-Z]+\\.[1-9][0-9]*$"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "verification"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "spec": {
                "enum": [
                  "CT-1",
                  "CT-6"
                ]
              },
              "ref": {
                "type": "string",
                "pattern": "^[A-Z]-[1-9][0-9]*$"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "controle"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "spec": {
                "const": "CT-6"
              },
              "ref": {
                "type": "string",
                "pattern": "^[1-8]$"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "partie"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "spec": {
                "const": "CT-1"
              },
              "ref": {
                "enum": [
                  "evenement",
                  "voisins",
                  "chemin",
                  "manifeste",
                  "manifeste_sig",
                  "cles",
                  "approbations",
                  "jeton_rfc3161",
                  "preuve_ots",
                  "registre",
                  "certificat_commit",
                  "validateurs",
                  "points_de_controle",
                  "attestation_perimetre"
                ]
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "section"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^§[0-9]+(\\.[0-9]+)*$"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "clause"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "spec": {
                "const": "CT-7"
              },
              "ref": {
                "type": "string",
                "pattern": "^CL-[1-9][0-9]*$"
              }
            }
          }
        }
      ]
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "serves"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CL-[1-9][0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "serves": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MC-[1-9][0-9]*$"
          }
        }
      }
    },
    "lacune": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "rows",
        "response",
        "bound",
        "owner",
        "rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^L-[1-9][0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MC-[1-9][0-9]*$"
          }
        },
        "response": {
          "enum": [
            "risque_accepte",
            "proposition",
            "renvoi",
            "releve_du_client"
          ]
        },
        "bound": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rule": {
          "type": "string",
          "pattern": "^EX-[0-9A-Z]+\\.[1-9][0-9]*$"
        }
      }
    },
    "cas_invalides_matrice": {
      "description": "Fichier `spec/vecteurs/ct-7/matrice/invalides/attendu.json` (CT-7 EX-A.14) : pour chaque copie altérée de la matrice, l'altération et la liste exacte des MX- en échec, dans l'ordre numérique.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "family",
        "note",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 0
        },
        "family": {
          "const": "matrice-invalides"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "alteration",
              "failed"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "alteration": {
                "type": "string",
                "minLength": 1
              },
              "failed": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^MX-[1-9]$"
                }
              }
            }
          }
        }
      }
    },
    "grille_conformite": {
      "description": "Grille de l'épreuve à l'aveugle du responsable de la conformité (`acceptation-conformite-attendu.json`, CT-7 EX-9.2, EX-9.3), dérivée de matrice-conformite.json ; jamais remise à la personne éprouvée.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "test",
        "rule",
        "source",
        "success",
        "questions",
        "sixth_question"
      ],
      "properties": {
        "version": {
          "const": 0
        },
        "test": {
          "const": "acceptation-conformite"
        },
        "rule": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "success": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "passage",
              "row",
              "expected",
              "table_elements"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^P[1-5]$"
              },
              "passage": {
                "type": "string"
              },
              "row": {
                "type": "string",
                "pattern": "^MC-[1-9][0-9]*$"
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "a_pieces",
                  "b_not_covered",
                  "b_client",
                  "c_status",
                  "c_applicability",
                  "c_from"
                ],
                "properties": {
                  "a_pieces": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "relation",
                        "element",
                        "condition",
                        "pieces"
                      ],
                      "properties": {
                        "relation": {
                          "enum": [
                            "repond_a",
                            "contribue_a"
                          ]
                        },
                        "element": {
                          "type": "string"
                        },
                        "condition": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "pieces": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "b_not_covered": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "b_client": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "c_status": {
                    "enum": [
                      "couvert",
                      "partiel",
                      "hors_perimetre"
                    ]
                  },
                  "c_applicability": {
                    "type": "string"
                  },
                  "c_from": {
                    "type": "array"
                  }
                }
              },
              "table_elements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "sixth_question": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "expected_answer",
            "expected"
          ],
          "properties": {
            "question": {
              "type": "string"
            },
            "expected_answer": {
              "const": "non"
            },
            "expected": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
