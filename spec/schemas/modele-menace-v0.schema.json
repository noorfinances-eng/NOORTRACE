{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noortrace.example/schemas/v0/modele-menace.schema.json",
  "title": "Modèle de menace par composant (CT-7 §3)",
  "description": "Forme lisible par machine de la table de CT-7 §3.4 : composants, tables sources consolidées et menaces MN-, chacune avec sa réponse, sa détection, son risque résiduel et le test que CT-9 doit écrire. La table du texte et ce fichier disent la même chose (RV-5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "spec", "spec_version", "date", "components", "source_tables", "threats"],
  "properties": {
    "version": { "const": 0 },
    "kind": { "const": "modele-menace" },
    "spec": { "const": "CT-7" },
    "spec_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/composant" }
    },
    "source_tables": {
      "description": "Tables de menaces des autres spécifications consolidées par CT-7 (CT-7 EX-3.3) et leur nombre de lignes au moment de la consolidation.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec", "section", "rows"],
        "properties": {
          "spec": { "$ref": "#/$defs/spec" },
          "section": { "$ref": "#/$defs/section" },
          "rows": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "threats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/menace" }
    }
  },
  "$defs": {
    "spec": { "type": "string", "pattern": "^CT-[1-9]$" },
    "section": { "type": "string", "pattern": "^[0-9A-Z]+(\\.[0-9]+)*$" },
    "texte": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "composant_id": {
      "type": "string",
      "enum": ["hote_agent", "mandataire_mcp", "passerelle_modele", "sdk_otel", "ecrivain_stockage", "worm_gel", "cles", "approbation_console", "registre", "ancrage", "verificateur", "exploitant", "administrateur_client", "reseau"]
    },
    "composant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "holds", "trust"],
      "properties": {
        "id": { "$ref": "#/$defs/composant_id" },
        "name": { "$ref": "#/$defs/texte" },
        "holds": { "$ref": "#/$defs/texte" },
        "trust": { "$ref": "#/$defs/texte" }
      }
    },
    "renvoi": {
      "description": "Renvoi exact : « CT-n EX-s.k », « CT-n §s.s » ou « CT-n XX-k » (identifiant d'une vérification d'une famille, défini comme première cellule d'une ligne de table de la spécification citée).",
      "type": "string",
      "pattern": "^CT-[1-9] (EX-[0-9A-Z]+\\.[0-9]+|§[0-9A-Z]+(\\.[0-9]+)*|[A-Z]{1,2}-[0-9]+)$"
    },
    "texte_avec_renvois": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "refs"],
      "properties": {
        "text": { "$ref": "#/$defs/texte" },
        "refs": {
          "description": "Les renvois de `text`, dans l'ordre de leur première occurrence, sans doublon (RV-4).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/renvoi" }
        }
      }
    },
    "risque_accepte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "bound", "owner"],
      "properties": {
        "id": { "type": "string", "pattern": "^RA-[1-9][0-9]*$" },
        "name": { "$ref": "#/$defs/texte" },
        "bound": { "$ref": "#/$defs/texte" },
        "owner": { "type": "string", "enum": ["client", "exploitant_noortrace", "reviseur", "operateur_validateur"] }
      }
    },
    "grille_securite": {
      "description": "Grille de l'épreuve à l'aveugle du responsable de la sécurité (`spec/vecteurs/ct-7/acceptation-securite-attendu.json`, CT-7 EX-9.1) : six scénarios, la menace attendue et les éléments attendus ; jamais remise à la personne éprouvée.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "test", "rule", "success", "scenarios"],
      "properties": {
        "version": { "const": 0 },
        "test": { "const": "acceptation-securite" },
        "rule": { "type": "string" },
        "success": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "scenario", "threat", "expected"],
            "properties": {
              "id": { "type": "string", "pattern": "^S[1-6]$" },
              "scenario": { "type": "string", "minLength": 1 },
              "threat": { "type": "string", "pattern": "^MN-[1-9][0-9]*$" },
              "expected": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "menace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "stride", "actor", "asset", "effect", "response", "detection", "residual", "test", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^MN-[1-9][0-9]*$" },
        "component": { "$ref": "#/$defs/composant_id" },
        "stride": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["usurpation", "alteration", "repudiation", "divulgation", "deni_de_service", "elevation_de_privilege"] }
        },
        "actor": { "$ref": "#/$defs/texte" },
        "asset": { "$ref": "#/$defs/texte" },
        "effect": { "$ref": "#/$defs/texte" },
        "response": { "$ref": "#/$defs/texte_avec_renvois" },
        "detection": { "$ref": "#/$defs/texte_avec_renvois" },
        "residual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "accepted_risk"],
          "properties": {
            "text": { "$ref": "#/$defs/texte" },
            "accepted_risk": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/risque_accepte" }
              ]
            }
          }
        },
        "test": { "type": "string", "pattern": "^Le test échoue si la réponse est retirée : ", "maxLength": 4096 },
        "sources": {
          "description": "Lignes des tables sources que cette menace consolide, désignées par la première cellule de la ligne, gras retiré, ou « puce n » pour une liste (RV-6).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spec", "section", "row"],
            "properties": {
              "spec": { "$ref": "#/$defs/spec" },
              "section": { "$ref": "#/$defs/section" },
              "row": { "$ref": "#/$defs/texte" }
            }
          }
        }
      }
    }
  }
}
