{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noortrace.example/schemas/v0/politique-approbation.schema.json",
  "title": "Politique d'approbation NOORTRACE, version 0",
  "description": "Document qui forme le membre /policy/approval/rules de l'ensemble de politique de l'enregistreur (CT-2 §15.1 ; CT-2 le valide avant tout scellement, sans l'évaluer, CT-2 EX-15.4 pas 3) et que le service d'approbation évalue avant chaque relais d'un appel d'outil (CT-3 §4 à §6). Il est haché avec l'ensemble de politique (CT-2 EX-10.21) : tout changement produit un événement noortrace.journal.politique. Les contraintes qu'un schéma n'exprime pas (noms de règles uniques, profondeur et nombre de prédicats, syntaxe des pointeurs au-delà du motif, chaînes Unicode bien formées, identités uniques dans separation) sont celles de la validation au chargement (CT-3 EX-4.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [ "version", "default", "rules", "approver_set", "separation" ],
  "properties": {
    "version": {
      "const": 0,
      "description": "Version du format de ce document. Le nom de l'instance est policy.version de l'ensemble de politique (CT-2 EX-10.21), pas ce membre."
    },
    "default": { "$ref": "#/$defs/regle_defaut" },
    "rules": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/regle" },
      "description": "Règles, dans l'ordre du document. L'ordre ne change pas la décision rendue ; parmi les issues de même rang, il désigne la règle retenue, dont viennent le nom écrit dans policy.rule, contest_ms et, pour une règle fenetre, la fenêtre ouverte ou consommée (CT-3 EX-4.9, §6.2)."
    },
    "approver_set": { "$ref": "#/$defs/jeu_approbateurs" },
    "separation": { "$ref": "#/$defs/separation" }
  },
  "$defs": {
    "adresse": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$",
      "description": "Adresse secp256k1 de 20 octets, hexadécimal minuscule (CT-1 §3, pas de somme de contrôle EIP-55)."
    },
    "nom_regle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^ \\[\\]\\u0000-\\u001F\\u007F-\\u009F](?:[^\\[\\]\\u0000-\\u001F\\u007F-\\u009F]{0,254}[^ \\[\\]\\u0000-\\u001F\\u007F-\\u009F])?$",
      "description": "Nom de la règle, recopié dans policy.rule (CT-1 §5.3). Ni crochet, ni caractère de contrôle, ni espace en tête ou en fin. Unique dans le document, règle par défaut comprise (EX-4.2)."
    },
    "description": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 1024 }
      ],
      "description": "Texte libre montré aux approbateurs par la console (CT-3 §13). Sans effet sur l'évaluation."
    },
    "delai_contestation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000,
      "description": "Fenêtre de contestation en millisecondes (CT-3 §5.6 et §10) ; 0 : aucune."
    },
    "selecteur_outil": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}|(?:[A-Za-z0-9][A-Za-z0-9._:/-]{0,126})?\\*)$",
      "description": "Nom annoncé exact (CT-2 EX-4.10, motif de CT-1 execution.tool), ou préfixe suivi d'un seul * final qui désigne tout nom annoncé commençant par ce préfixe ; * seul désigne tout outil (CT-3 EX-4.3)."
    },
    "pointeur": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^/arguments(?:/(?:[^/~]|~[01])*)*$",
      "description": "Pointeur JSON (RFC 6901) dans l'objet { \"arguments\": <arguments en clair> } ; il commence donc par /arguments (CT-3 EX-4.4). Au plus 32 jetons (EX-4.2)."
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]{0,29})(?:\\.[0-9]{1,18})?$",
      "description": "Nombre décimal exact écrit en chaîne : au plus 30 chiffres avant le point et 18 après, sans exposant, sans signe +, sans zéro de tête (CT-3 EX-4.6)."
    },
    "chaine_litterale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/tout" },
        { "$ref": "#/$defs/un" },
        { "$ref": "#/$defs/aucun" },
        { "$ref": "#/$defs/predicat" }
      ],
      "description": "Arbre de prédicats et de combinaisons, évalué en logique à trois valeurs (CT-3 EX-4.8). Au plus 8 niveaux et 64 prédicats par règle (EX-4.2)."
    },
    "tout": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "all" ],
      "properties": {
        "all": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "un": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "any" ],
      "properties": {
        "any": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "aucun": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "none" ],
      "properties": {
        "none": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "predicat": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "path", "op", "value" ],
      "properties": {
        "path": { "$ref": "#/$defs/pointeur" },
        "op": {
          "enum": [
            "existe",
            "egal",
            "dans",
            "commence_par",
            "finit_par",
            "egal_numerique",
            "strictement_superieur",
            "superieur_ou_egal",
            "strictement_inferieur",
            "inferieur_ou_egal"
          ]
        },
        "value": true
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "existe" } } },
          "then": { "properties": { "value": { "type": "null" } } }
        },
        {
          "if": { "properties": { "op": { "const": "egal" } } },
          "then": {
            "properties": {
              "value": {
                "oneOf": [
                  { "type": "string", "maxLength": 1024 },
                  { "type": "boolean" }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "dans" } } },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "uniqueItems": true,
                "items": { "type": "string", "maxLength": 1024 }
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "enum": [ "commence_par", "finit_par" ] } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/chaine_litterale" } } }
        },
        {
          "if": {
            "properties": {
              "op": { "enum": [ "egal_numerique", "strictement_superieur", "superieur_ou_egal", "strictement_inferieur", "inferieur_ou_egal" ] }
            }
          },
          "then": { "properties": { "value": { "$ref": "#/$defs/decimal" } } }
        }
      ]
    },
    "fenetre": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "duration_ms", "max_calls", "same_arguments" ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "description": "Durée de la fenêtre, comptée depuis approval.at de la décision qui l'ouvre (CT-3 EX-5.4). Au plus 24 heures."
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Nombre maximal d'appels autorisés sous la fenêtre, appel ouvrant non compris."
        },
        "same_arguments": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pointeur" },
          "description": "Pointeurs dont la valeur, une chaîne, doit être égale à celle de la demande ouvrante ; le demandeur (delegation.launched_by) et le nom annoncé de l'outil font toujours partie de la portée (CT-3 EX-5.2)."
        }
      }
    },
    "regle": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "description", "tools", "when", "level", "decision", "window", "contest_ms" ],
      "properties": {
        "name": { "$ref": "#/$defs/nom_regle" },
        "description": { "$ref": "#/$defs/description" },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/selecteur_outil" }
        },
        "when": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/condition" }
          ],
          "description": "null : la règle s'applique à tout appel des outils sélectionnés (condition VRAI)."
        },
        "level": { "enum": [ "automatique", "fenetre", "revue" ] },
        "decision": {
          "enum": [ "autorise", "refuse", null ],
          "description": "Pour le niveau automatique seulement ; null pour fenetre et revue."
        },
        "window": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/fenetre" }
          ],
          "description": "Pour le niveau fenetre seulement ; null sinon."
        },
        "contest_ms": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/delai_contestation" }
          ],
          "description": "Pour les niveaux fenetre et revue ; null pour automatique."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "level": { "const": "automatique" } } },
          "then": {
            "properties": {
              "decision": { "enum": [ "autorise", "refuse" ] },
              "window": { "type": "null" },
              "contest_ms": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "level": { "const": "fenetre" } } },
          "then": {
            "properties": {
              "decision": { "type": "null" },
              "window": { "$ref": "#/$defs/fenetre" },
              "contest_ms": { "$ref": "#/$defs/delai_contestation" }
            }
          }
        },
        {
          "if": { "properties": { "level": { "const": "revue" } } },
          "then": {
            "properties": {
              "decision": { "type": "null" },
              "window": { "type": "null" },
              "contest_ms": { "$ref": "#/$defs/delai_contestation" }
            }
          }
        }
      ]
    },
    "regle_defaut": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "description", "level", "decision", "contest_ms" ],
      "description": "Règle par défaut : elle s'applique quand aucune règle ne s'applique (CT-3 EX-4.10). Niveau automatique ou revue, jamais fenetre.",
      "properties": {
        "name": { "$ref": "#/$defs/nom_regle" },
        "description": { "$ref": "#/$defs/description" },
        "level": { "enum": [ "automatique", "revue" ] },
        "decision": { "enum": [ "autorise", "refuse", null ] },
        "contest_ms": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/delai_contestation" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "level": { "const": "automatique" } } },
          "then": {
            "properties": {
              "decision": { "enum": [ "autorise", "refuse" ] },
              "contest_ms": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "level": { "const": "revue" } } },
          "then": {
            "properties": {
              "decision": { "type": "null" },
              "contest_ms": { "$ref": "#/$defs/delai_contestation" }
            }
          }
        }
      ]
    },
    "seuil": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "required", "size" ],
      "properties": {
        "required": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "size": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "jeu_approbateurs": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "source", "chain_id", "registry", "set", "members", "threshold" ],
      "description": "D'où le service lit le jeu d'approbateurs et le seuil de l'organisation (CT-3 §8). registre : CuratorSetRegistry à cette adresse, sur cette chaîne, pour l'org_id du journal ; set épingle le CuratorSet attendu : un registre qui désigne un autre jeu donne une lecture illisible (jeu_non_attendu, CT-3 EX-8.1), et adopter un autre jeu exige une nouvelle version de politique. statique : jeu écrit ici, admis seulement hors production (vecteurs, démonstration).",
      "properties": {
        "source": { "enum": [ "registre", "statique" ] },
        "chain_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          ]
        },
        "registry": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/adresse" }
          ]
        },
        "set": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/adresse" }
          ],
          "description": "Adresse du CuratorSet de l'organisation que le registre doit désigner (CT-3 EX-8.1, pas 2) ; null pour un jeu statique."
        },
        "members": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "minItems": 1, "maxItems": 65535, "uniqueItems": true, "items": { "$ref": "#/$defs/adresse" } }
          ]
        },
        "threshold": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/seuil" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "registre" } } },
          "then": {
            "properties": {
              "chain_id": { "type": "integer" },
              "registry": { "$ref": "#/$defs/adresse" },
              "set": { "$ref": "#/$defs/adresse" },
              "members": { "type": "null" },
              "threshold": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "statique" } } },
          "then": {
            "properties": {
              "chain_id": { "type": "null" },
              "registry": { "type": "null" },
              "set": { "type": "null" },
              "members": { "type": "array" },
              "threshold": { "$ref": "#/$defs/seuil" }
            }
          }
        }
      ]
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "self_approval", "identities" ],
      "description": "Séparation des tâches (CT-3 §10) : le demandeur peut-il approuver sa propre demande, et quelles adresses d'approbateur chaque identité de demandeur détient.",
      "properties": {
        "self_approval": {
          "enum": [ "interdite", "permise" ],
          "description": "interdite (recommandé) : une signature d'une adresse associée au demandeur n'est pas comptée pour la demande de ce demandeur."
        },
        "identities": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "launched_by", "addresses" ],
            "properties": {
              "launched_by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Identité telle que delegation.launched_by la porte (CT-1 §5.3). Unique dans identities (EX-4.2)."
              },
              "addresses": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/adresse" }
              }
            }
          }
        }
      }
    }
  }
}
