        "bitcoin": {
          "oneOf": [
            {
              "$ref": "#/$defs/faits_bitcoin"
            },
            {
              "type": "null"
            }
          ]
        },
        "registry": {
          "oneOf": [
            {
              "$ref": "#/$defs/faits_ancre_registre_point"
