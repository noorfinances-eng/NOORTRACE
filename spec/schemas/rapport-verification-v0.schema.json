    "faits_perimetre": {
      "description": "Attestation de périmètre retenue (CT-6 EX-6.20, révision 0.3) : AT-1 à AT-5 réussies, AT-6 réussie ou non exécutée faute d'inscription (partie_absente) ou faute de clé reliée à l'événement prouvé (ancre_absente). Valeurs recalculées (digest) ou déclarées par l'attestation et ses signataires ; provenance vaut toujours declaree : le vérificateur établit qui a signé, jamais que le périmètre est exact. inscription : l'événement qui inscrit l'attestation au journal (AT-6), null sans inscription vérifiée ; key_id est la clé de l'inscription, celle de l'événement prouvé ; same_policy_version vrai si AT-7 a réussi, c'est-à-dire si la version de politique de l'événement porte le même nom que celle de l'inscription (un nom, pas la preuve que l'attestation était en vigueur).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "digest",
        "org_id",
        "journal_ids",
        "valid_from",
        "valid_until",
        "issued_at",
        "signers",
        "required",
        "size",
        "set_source",
        "agents",
        "capture_channels",
        "exceptions",
        "egress_default_policy",
        "egress_rules_sha256",
        "inscription"
      ],
      "properties": {
        "provenance": {
          "const": "declaree"
        },
        "digest": {
          "$ref": "#/$defs/hex32"
        },
        "org_id": {
          "$ref": "#/$defs/hex32"
        },
        "journal_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hex32"
          }
        },
        "valid_from": {
          "$ref": "#/$defs/horodatage_journal"
        },
        "valid_until": {
          "$ref": "#/$defs/horodatage_journal"
        },
        "issued_at": {
          "$ref": "#/$defs/horodatage_journal"
        },
        "signers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/adresse"
          }
        },
        "required": {
          "$ref": "#/$defs/entier_sur"
        },
        "size": {
          "$ref": "#/$defs/entier_sur"
        },
        "set_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "agents": {
          "$ref": "#/$defs/entier_sur"
        },
        "capture_channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "mandataire_mcp",
              "passerelle",
              "icap",
              "miroir",
              "sdk",
              "opentelemetry"
            ]
          }
        },
        "exceptions": {
          "$ref": "#/$defs/entier_sur"
        },
        "egress_default_policy": {
          "enum": [
            "refus_par_defaut",
            "autorisation_par_defaut"
          ]
        },
        "egress_rules_sha256": {
          "$ref": "#/$defs/hex32"
        },
        "inscription": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "seq",
                "hash",
                "ts",
                "key_id",
                "policy_version",
                "policy_sha256",
                "same_policy_version"
              ],
              "properties": {
                "seq": {
                  "$ref": "#/$defs/entier_sur"
                },
                "hash": {
                  "$ref": "#/$defs/hex32"
                },
                "ts": {
                  "$ref": "#/$defs/horodatage_journal"
                },
                "key_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "policy_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "policy_sha256": {
                  "$ref": "#/$defs/hex32"
                },
                "same_policy_version": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "faits": {
      "description": "Valeurs établies par des contrôles réussis, et seulement elles : une clé vaut null quand son contrôle n'a pas réussi (CT-6 EX-6.13). Les champs de timestamp, bitcoin et registry sont ceux que les sections 9.7, 10.7 et 11.6 exigent (EX-9.19, EX-10.14, EX-11.21). checkpoint (révision 0.2, facultatif pour la compatibilité des rapports antérieurs, toujours écrit par un vérificateur de la révision 0.2) : le point de contrôle du journal qui couvre l'événement, établi par les vérifications K- (EX-6.17), null sans partie points-de-controle.json vérifiée. perimeter (révision 0.3 de CT-6, facultatif pour la compatibilité des rapports antérieurs, toujours écrit par un vérificateur de la révision 0.3) : l'attestation de périmètre retenue (EX-6.20), null sans partie attestation-perimetre.json ou quand elle n'est pas retenue ; valeurs déclarées, jamais prouvées.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorder_keys",
        "approval",
        "timestamp",
        "bitcoin",
        "registry"
      ],
      "properties": {
        "recorder_keys": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_key_id",
                "manifest_key_id",
                "source",
                "event_key_source",
                "manifest_key_source"
              ],
              "properties": {
                "event_key_id": {
                  "type": "string",
                  "minLength": 1
                },
                "manifest_key_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "enum": [
                    "dossier",
                    "ancres",
                    "registre",
                    "mixte"
                  ]
                },
                "event_key_source": {
                  "enum": [
                    "dossier",
                    "ancres",
                    "registre"
                  ]
                },
                "manifest_key_source": {
                  "enum": [
                    "dossier",
                    "ancres",
                    "registre"
                  ]
                }
              },
              "description": "Clés employées (EX-6.8) : celle de l'événement prouvé et celle du manifeste. source : provenance commune des deux clés, ou mixte quand elles diffèrent ; event_key_source et manifest_key_source : provenance de chaque clé (EX-3.6)."
            },
            {
              "type": "null"
            }
          ]
        },
        "approval": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision",
                "ticket",
                "approvers",
                "required",
                "size",
                "set_source"
              ],
              "properties": {
                "decision": {
                  "enum": [
                    "approuve",
                    "refuse",
                    "expire"
                  ]
                },
                "ticket": {
                  "type": "string",
                  "minLength": 1
                },
                "approvers": {
                  "type": "array",
                  "minItems": 0,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/adresse"
                  }
                },
                "required": {
                  "$ref": "#/$defs/entier_sur"
                },
                "size": {
                  "$ref": "#/$defs/entier_sur"
                },
                "set_source": {
                  "const": "dossier"
                }
              },
              "description": "Décision liée à l'événement (EX-6.8, F3) : approbation, refus signés par approvers, ou demande expirée sans signature (approvers vide)."
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "oneOf": [
            {
              "$ref": "#/$defs/faits_horodatage"
            },
            {
              "type": "null"
            }
          ]
        },
        "bitcoin": {
          "oneOf": [
            {
              "$ref": "#/$defs/faits_bitcoin"
            },
            {
              "type": "null"
            }
          ]
        },
        "registry": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chain_id",
                "entries",
                "certificates"
              ],
              "properties": {
                "chain_id": {
                  "type": "string",
                  "minLength": 1
                },
                "entries": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role",
                      "block_number",
                      "block_hash",
                      "block_time",
                      "transaction_index",
                      "transaction_hash_declared",
                      "emitter",
                      "event"
                    ],
                    "properties": {
                      "role": {
                        "enum": [
                          "cloture",
                          "ancre",
                          "inscription",
                          "ancre_point_de_controle"
                        ]
                      },
                      "block_number": {
                        "$ref": "#/$defs/entier_sur"
                      },
                      "block_hash": {
                        "$ref": "#/$defs/hex32"
                      },
                      "block_time": {
                        "$ref": "#/$defs/instant"
                      },
                      "transaction_index": {
                        "$ref": "#/$defs/entier_sur"
                      },
                      "transaction_hash_declared": {
                        "$ref": "#/$defs/hex32"
                      },
                      "emitter": {
                        "$ref": "#/$defs/adresse"
                      },
                      "event": {
                        "description": "Valeurs décodées du journal prouvé (CT-6 section 11).",
                        "type": "object"
                      }
                    }
                  }
                },
                "certificates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "height",
                      "valset_hash",
                      "set_source",
                      "set_size",
                      "quorum",
                      "signers"
                    ],
                    "properties": {
                      "height": {
                        "$ref": "#/$defs/entier_sur"
                      },
                      "valset_hash": {
                        "$ref": "#/$defs/hex32"
                      },
                      "set_source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "set_size": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quorum": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "signers": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint": {
          "description": "Révision 0.2 : point de contrôle du journal qui couvre l'événement (EX-6.17), ou null.",
          "oneOf": [
            {
              "$ref": "#/$defs/faits_point_de_controle"
            },
            {
              "type": "null"
            }
          ]
        },
        "perimeter": {
          "oneOf": [
            {
              "$ref": "#/$defs/faits_perimetre"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
