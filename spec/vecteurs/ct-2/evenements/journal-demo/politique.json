{
  "version": "demo-2026-11",
  "approval": {
    "rules": [
      {
        "tool": "demo__payments.create",
        "when": "amount > 5000 CHF",
        "decision": "a_approuver",
        "note": "syntaxe CT-3, opaque pour CT-2"
      }
    ],
    "mode": "erreur",
    "hold_timeout_ms": 50000,
    "expire_after_ms": 3600000,
    "timeout_ms": 2000,
    "service": {
      "url": null,
      "socket": "/run/noortrace/approbation.sock",
      "token": null,
      "peer_user": "approbateur-demo"
    }
  },
  "redaction": {
    "version": 0,
    "name": "pii-v1",
    "description": "Politique de redaction publiee avec CT-2 : identifiants personnels et financiers courants (IBAN, numero AVS, adresse electronique, numero de telephone international, numero de carte de paiement) remplaces par un jeton type dans toutes les pieces.",
    "pseudonym_key": null,
    "named_patterns": {
      "numero-sinistre": {
        "pattern": "\\b20[0-9]{2}-[0-9]{5}\\b",
        "description": "Numero de dossier de sinistre AAAA-NNNNN de l'assureur de demonstration ; n'est pas une donnee personnelle, declare ici pour montrer une regex nommee et laisse hors de toute regle."
      }
    },
    "rules": [
      {
        "id": "identifiants-arguments-resultat",
        "description": "Arguments et resultats de tout appel d'outil : tout texte.",
        "scopes": [
          "arguments",
          "resultat"
        ],
        "tools": "*",
        "detectors": [
          {
            "type": "iban"
          },
          {
            "type": "avs"
          },
          {
            "type": "carte"
          },
          {
            "type": "email"
          },
          {
            "type": "telephone"
          }
        ],
        "action": {
          "kind": "remplacer"
        }
      },
      {
        "id": "identifiants-modele",
        "description": "Requetes, reponses et prompt systeme des echanges de modele : tout texte.",
        "scopes": [
          "requete",
          "reponse",
          "prompt_systeme"
        ],
        "tools": "*",
        "detectors": [
          {
            "type": "iban"
          },
          {
            "type": "avs"
          },
          {
            "type": "carte"
          },
          {
            "type": "email"
          },
          {
            "type": "telephone"
          }
        ],
        "action": {
          "kind": "remplacer"
        }
      },
      {
        "id": "identifiants-contexte",
        "description": "Documents de contexte remis par le SDK : tout texte.",
        "scopes": [
          "contexte"
        ],
        "tools": "*",
        "detectors": [
          {
            "type": "iban"
          },
          {
            "type": "avs"
          },
          {
            "type": "carte"
          },
          {
            "type": "email"
          },
          {
            "type": "telephone"
          }
        ],
        "action": {
          "kind": "remplacer"
        }
      }
    ]
  },
  "servers": {
    "demo": {
      "transport": {
        "type": "http",
        "url": "http://outils-demo:8000/mcp",
        "headers": {},
        "oauth": null,
        "tls": null
      },
      "protocol": "2026-07-28",
      "class_default": null,
      "timeout_ms": null,
      "tools": {
        "claims.get": {
          "class": "lecture",
          "timeout_ms": null,
          "effects": [
            {
              "system": "demo",
              "action": "lecture",
              "object": "/arguments/claim_id",
              "amount": null,
              "currency": null
            }
          ],
          "failure": null
        },
        "claims.search": {
          "class": "lecture",
          "timeout_ms": 30000,
          "effects": null,
          "failure": "passant"
        },
        "payments.create": {
          "class": "ecriture",
          "timeout_ms": null,
          "effects": [
            {
              "system": "demo",
              "action": "ecriture",
              "object": "/result/structuredContent/payment_id",
              "amount": "/arguments/amount",
              "currency": "/arguments/currency"
            }
          ],
          "failure": null
        }
      },
      "uri_prefixes": [],
      "relay": null
    }
  },
  "model": {
    "routes": [
      {
        "path": "/v1/messages",
        "format": "anthropic-messages",
        "upstream": "http://modele-demo:8080",
        "provider_label": "demo",
        "credentials": "propre",
        "secret": {
          "file": "/run/secrets/cle-modele-demo"
        },
        "auth_header": "x-api-key",
        "passthrough": []
      }
    ]
  },
  "failure": {
    "ecriture": "bloquant",
    "lecture": "passant",
    "modele": "bloquant",
    "approval_service": {
      "ecriture": "bloquant",
      "lecture": "passant"
    },
    "pending_max_events": 10000,
    "pending_max_ms": 300000
  }
}
