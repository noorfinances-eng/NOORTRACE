    "admis": false,
    "note": "classe Unicode"
  },
  {
    "pattern": "\\A",
    "admis": false,
    "note": "\\A : RE2 seulement"
  },
  {
    "pattern": "[[:alpha:]]",
    "admis": false,
    "note": "classe POSIX : RE2 seulement"
  },
  {
    "pattern": "(?=a)",
    "admis": false,
    "note": "recherche avant"
  },
  {
    "pattern": "(?i)a",
    "admis": false,
    "note": "drapeau en ligne"
  },
  {
    "pattern": "a*+",
    "admis": false,
    "note": "quantificateur possessif"
  },
  {
    "pattern": "(a)\\1",
    "admis": false,
    "note": "référence arrière"
  },
  {
