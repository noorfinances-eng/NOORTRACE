{
  "version": 0,
  "name": "pii-pseudo-test",
  "description": "Politique de test des vecteurs CT-2 : pii-v1 avec l'action pseudonyme sur chaque regle. La cle de pseudonymisation de test est publique et jetable (INDEX.md) ; elle ne doit jamais servir hors des vecteurs.",
  "pseudonym_key": {
    "env": "NOORTRACE_VECTEURS_CLE_PSEUDO",
    "encoding": "hex"
  },
  "named_patterns": {
    "numero-sinistre": {
      "pattern": "\\b20[0-9]{2}-[0-9]{5}\\b",
      "description": "Numero de dossier de sinistre AAAA-NNNNN de l'assureur de demonstration ; n'est pas une donnee personnelle, declare ici pour montrer une regex nommee et laisse hors de toute regle."
    }
  },
  "rules": [
    {
      "id": "iban-champ",
      "description": "IBAN du beneficiaire designe par pointeur : pseudonyme calcule sur la chaine elle-meme.",
      "scopes": [
        "arguments"
      ],
      "tools": "*",
      "path": "/iban_beneficiaire",
      "detectors": [
        {
          "type": "champ",
          "label": "iban"
        }
      ],
      "action": {
        "kind": "pseudonyme"
      }
    },
    {
      "id": "identifiants-arguments-resultat",
      "description": "Arguments et resultats de tout appel d'outil : tout texte.",
      "scopes": [
        "arguments",
        "resultat"
      ],
      "tools": "*",
      "detectors": [
        {
          "type": "iban"
        },
        {
          "type": "avs"
        },
        {
          "type": "carte"
        },
        {
          "type": "email"
        },
        {
          "type": "telephone"
        }
      ],
      "action": {
        "kind": "pseudonyme"
      }
    },
    {
      "id": "identifiants-modele",
      "description": "Requetes, reponses et prompt systeme des echanges de modele : tout texte.",
      "scopes": [
        "requete",
        "reponse",
        "prompt_systeme"
      ],
      "tools": "*",
      "detectors": [
        {
          "type": "iban"
        },
        {
          "type": "avs"
        },
        {
          "type": "carte"
        },
        {
          "type": "email"
        },
        {
          "type": "telephone"
        }
      ],
      "action": {
        "kind": "pseudonyme"
      }
    },
    {
      "id": "identifiants-contexte",
      "description": "Documents de contexte remis par le SDK : tout texte.",
      "scopes": [
        "contexte"
      ],
      "tools": "*",
      "detectors": [
        {
          "type": "iban"
        },
        {
          "type": "avs"
        },
        {
          "type": "carte"
        },
        {
          "type": "email"
        },
        {
          "type": "telephone"
        }
      ],
      "action": {
        "kind": "pseudonyme"
      }
    }
  ]
}
