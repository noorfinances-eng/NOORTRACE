    {
      "name": "paiement hors CHF",
      "description": "Les paiements de sinistre se font en francs suisses.",
      "tools": [
        "sap.payments.create"
      ],
      "when": {
        "none": [
          {
            "path": "/arguments/currency",
            "op": "egal",
            "value": "CHF"
          }
        ]
      },
      "level": "automatique",
      "decision": "refuse",
      "window": null,
      "contest_ms": null
    },
    {
      "name": "beneficiaire hors liste blanche",
      "description": null,
      "tools": [
        "sap.payments.create"
      ],
      "when": {
        "none": [
          {
            "path": "/arguments/beneficiary_iban",
            "op": "dans",
            "value": [
              "CH9300762011623852957",
              "CH5604835012345678009"
            ]
          }
        ]
      },
      "level": "automatique",
      "decision": "refuse",
      "window": null,
      "contest_ms": null
    },
    {
      "name": "paiement <= 1000 CHF",
      "description": null,
      "tools": [
        "sap.payments.create"
      ],
      "when": {
        "all": [
          {
            "path": "/arguments/currency",
            "op": "egal",
            "value": "CHF"
          },
          {
            "path": "/arguments/amount",
            "op": "strictement_superieur",
            "value": "0"
          },
          {
            "path": "/arguments/amount",
            "op": "inferieur_ou_egal",
            "value": "1000"
          }
        ]
      },
      "level": "automatique",
      "decision": "autorise",
      "window": null,
      "contest_ms": null
    },
    {
      "name": "paiement de 1000 a 5000 CHF",
      "description": "Une approbation ouvre, pour le même demandeur et le même bénéficiaire, une fenêtre de 8 heures et 20 paiements.",
      "tools": [
        "sap.payments.create"
      ],
      "when": {
        "all": [
          {
            "path": "/arguments/currency",
            "op": "egal",
            "value": "CHF"
          },
          {
            "path": "/arguments/amount",
            "op": "strictement_superieur",
            "value": "1000"
          },
          {
            "path": "/arguments/amount",
            "op": "inferieur_ou_egal",
            "value": "5000"
          }
        ]
      },
      "level": "fenetre",
      "decision": null,
      "window": {
        "duration_ms": 28800000,
        "max_calls": 20,
        "same_arguments": [
          "/arguments/beneficiary_iban"
        ]
      },
      "contest_ms": 0
    },
    {
      "name": "paiement > 5000 CHF",
      "description": "Chaque paiement est approuvé au seuil du jeu d'approbateurs.",
      "tools": [
        "sap.payments.create"
      ],
      "when": {
        "all": [
          {
            "path": "/arguments/currency",
            "op": "egal",
            "value": "CHF"
          },
          {
            "path": "/arguments/amount",
            "op": "strictement_superieur",
            "value": "5000"
          }
        ]
      },
      "level": "revue",
      "decision": null,
      "window": null,
      "contest_ms": 0
    },
    {
      "name": "suppression de sinistre",
      "description": "Toute suppression attend 15 minutes après le seuil : un autre approbateur peut s'y opposer.",
      "tools": [
        "crm.claims.delete"
